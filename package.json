{
  "name": "halina",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n emu,web -c magenta,cyan \"npm:emulators\" \"npm:web\"",
    "dev:lan": "concurrently -k -n emu,web -c magenta,cyan \"npm:emulators:lan\" \"npm:web:lan\"",
    "emulators": "firebase emulators:start --only auth,database --project demo-halina",
    "emulators:lan": "firebase emulators:start --only auth,database --project demo-halina --config firebase.lan.json",
    "web": "npm -w apps/web run dev",
    "web:lan": "npm -w apps/web run dev -- --host 0.0.0.0",
    "build": "npm -w apps/web run build",
    "preview": "npm -w apps/web run preview",
    "bots": "tsx tools/bots/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only auth,database --project demo-halina \"vitest run --config firebase/vitest.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,database --project demo-halina \"playwright test\"",
    "typecheck": "tsc -p packages/engine && tsc -p packages/content && tsc -p apps/web && tsc -p tools/bots",
    "lint": "npm run typecheck",
    "deploy": "npm run build && firebase deploy --only hosting,database"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "concurrently": "9.2.5",
    "fast-check": "4.10.2",
    "firebase": "12.19.0",
    "firebase-tools": "14.27.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
